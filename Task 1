#include <iostream>
#include <algorithm>
#include <string>
#include <vector>
using namespace std;

struct Node {
    int key, height;
    Node *left, *right;
    Node(int k) : key(k), height(1), left(nullptr), right(nullptr) {}
};

int height(Node* n) { return n ? n->height : 0; }
int balance(Node* n) { return n ? height(n->left) - height(n->right) : 0; }
void update(Node* n) { n->height = 1 + max(height(n->left), height(n->right)); }

Node* rotateRight(Node* y) {
    Node* x = y->left;
    y->left = x->right;
    x->right = y;
    update(y); update(x);
    return x;
}

Node* rotateLeft(Node* x) {
    Node* y = x->right;
    x->right = y->left;
    y->left = x;
    update(x); update(y);
    return y;
}

Node* insert(Node* root, int key) {
    // 1. Normal BST insert
    if (!root) return new Node(key);
    if (key < root->key) root->left = insert(root->left, key);
    else if (key > root->key) root->right = insert(root->right, key);
    else { cout << "Duplicate ignored.\n"; return root; }

    // 2. Update height and check balance
    update(root);
    int bf = balance(root);

    // 3. LL case
    if (bf > 1 && key < root->left->key) {
        cout << "LL case at " << root->key << "\n";
        return rotateRight(root);
    }
    // 4. RR case
    if (bf < -1 && key > root->right->key) {
        cout << "RR case at " << root->key << "\n";
        return rotateLeft(root);
    }
    // 5. LR case
    if (bf > 1 && key > root->left->key) {
        cout << "LR case at " << root->key << "\n";
        root->left = rotateLeft(root->left);
        return rotateRight(root);
    }
    // 6. RL case
    if (bf < -1 && key < root->right->key) {
        cout << "RL case at " << root->key << "\n";
        root->right = rotateRight(root->right);
        return rotateLeft(root);
    }

    // 7. Balanced, return unchanged
    return root;
}

void inorder(Node* r) {
    if (!r) return;
    inorder(r->left);
    cout << r->key << " ";
    inorder(r->right);
}

// Place node in grid at (row, col); children go 'off' columns left/right
void fill(Node* r, int row, int col, int off, vector<string>& g) {
    if (!r) return;
    string s = to_string(r->key);
    for (int i = 0; i < (int)s.size(); i++) g[row][col + i] = s[i];

    if (r->left) {
        for (int x = col - off; x <= col; x++) g[row + 1][x] = '-';
        g[row + 1][col - off] = '+';
        fill(r->left, row + 2, col - off, off / 2, g);
    }
    if (r->right) {
        for (int x = col; x <= col + off; x++) g[row + 1][x] = '-';
        g[row + 1][col + off] = '+';
        fill(r->right, row + 2, col + off, off / 2, g);
    }
}

void printTree(Node* root) {
    int h = height(root);
    int off = 3 * (1 << max(0, h - 2));
    vector<string> g(2 * h, string(4 * off + 6, ' '));
    fill(root, 0, 2 * off, off, g);
    for (auto& line : g) cout << line << "\n";
}

int main() {
    Node* root = nullptr;
    int n;
    cout << "How many numbers? ";
    cin >> n;

    for (int i = 0; i < n; i++) {
        int x;
        cout << "Enter number: ";
        cin >> x;
        root = insert(root, x);
        cout << "In-order: ";
        inorder(root);
        cout << "\n";
        printTree(root);
        cout << "\n";
    }
    return 0;
}
